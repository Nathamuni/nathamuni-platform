{
  // Must match the Worker that actually serves nathamuni.com. Workers Builds deploys to
  // the dashboard-configured project regardless of this field, which is why the previous
  // value ("nathamuni-com" — a Worker that does not exist) never broke CI. A local
  // `wrangler deploy` does honour it, though, and would have created a stray Worker
  // instead of updating production.
  "name": "nathamuni-platform",
  "compatibility_date": "2026-01-01",
  "main": "worker/index.mjs",
  "assets": {
    "directory": "./out",
    "not_found_handling": "404-page",
    "binding": "ASSETS",
    // Browser navigations are otherwise answered from ./out first (404 page) and never
    // reach the worker; the stable download link must always hit its redirect.
    "run_worker_first": ["/diet/latest.zip"]
  },
  // UTC crons, keep in sync with worker/telegram.mjs: 8:00 am IST starts the GitHub sync;
  // 5:45 pm IST daily posting nudge; 7 pm IST Sunday weekly review.
  "triggers": {
    "crons": ["30 2 * * *", "15 12 * * *", "30 13 * * SUN"]
  },
  "ai": {
    "binding": "AI"
  },
  // Anonymous question log + newsletter list ("nathamuni-inbox" KV).
  "kv_namespaces": [
    {
      "binding": "INBOX",
      "id": "968ff3b2478d472683029c0d8e3d7aad"
    }
  ]
}
